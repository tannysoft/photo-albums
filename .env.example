# ─── Firebase Web SDK (client) ─────────────────────────────────────────────
# Project settings → General → Your apps → Web app
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ─── Firebase Admin SDK (server) ───────────────────────────────────────────
# Project settings → Service accounts → Generate new private key
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Paste the whole private key in quotes, keep the literal \n escapes:
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
FIREBASE_PRIVATE_KEY=

# ─── Cloudflare R2 (S3 compatible) ─────────────────────────────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=photo-albums
# Optional: if you connect a public custom domain / r2.dev to the bucket,
# set the base URL here to serve images directly (faster, cacheable).
# Leave blank to serve everything through presigned-URL redirects.
NEXT_PUBLIC_R2_PUBLIC_BASE_URL=

# ─── App ───────────────────────────────────────────────────────────────────
# Comma-separated list of admin emails allowed into the dashboard.
# Leave blank to allow any authenticated Firebase user.
ADMIN_EMAILS=
