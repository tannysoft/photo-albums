rules_version = '2';

// This app accesses Firestore exclusively through the Firebase Admin SDK on the
// server (which bypasses these rules). No client-side Firestore access exists,
// so all direct client reads/writes are denied.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
